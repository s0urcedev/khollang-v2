{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|\\d+\\.\\d+|\\d+",
  "indentationRules": {
    "increaseIndentPattern": {
      "pattern": "^\\s*(if|else|match|case|otherwise|loop|function|procedure|structure)\\b",
      "flags": "i"
    },
    "decreaseIndentPattern": {
      "pattern": "^\\s*(end|else|case|otherwise)\\b",
      "flags": "i"
    }
  }
}
