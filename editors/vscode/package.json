{
  "name": "khollang",
  "displayName": "Khollang",
  "description": "Syntax highlighting for the Khollang programming language",
  "version": "1.1.0",
  "publisher": "s0urcedev",
  "repository": {
    "type": "git",
    "url": "https://github.com/s0urcedev/khollang-v2"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "khollang.run",
        "title": "Run File",
        "category": "Khollang",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "khollang.run",
          "when": "editorLangId == khollang",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "khollang.run",
          "when": "editorLangId == khollang"
        }
      ]
    },
    "languages": [
      {
        "id": "khollang",
        "aliases": [
          "Khollang",
          "khollang"
        ],
        "extensions": [
          ".kh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "khollang",
        "scopeName": "source.khollang",
        "path": "./syntaxes/khollang.tmLanguage.json"
      }
    ]
  }
}
